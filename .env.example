# Copy to .env. Never commit .env.
# Postgres (Supabase). Use the pooler URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradelab

# Local candle archive root (Parquet). Relative paths resolve from the repo root.
DATA_DIR=./data

# Market data only. V1 is read-only: never put trade-permission keys here.
BINANCE_API_KEY=
BINANCE_API_SECRET=
