# Copy to .env. Never commit .env.
# Postgres (Supabase). Use the pooler URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradelab

# Local candle archive root (Parquet). Relative paths resolve from the repo root.
DATA_DIR=./data

# Market data only. V1 is read-only: never put trade-permission keys here.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Content engine
TIMEZONE=Asia/Riyadh
CONTENT_STORE=json            # json | postgres
PREORDER_TARGET=20
# X API (posting needs OAuth 1.0a user context; metrics need the app bearer token). Leave empty for dry-run.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# Lab API: admin endpoints refuse every request until this is set. Use a long random string.
LAB_ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # add the landing/dashboard host in production
BRAND_NAME=مختبر الاستراتيجيات
# Payments (Lemon Squeezy, merchant of record). Webhook URL: https://<api-host>/api/webhooks/lemonsqueezy
LEMONSQUEEZY_SIGNING_SECRET=

# Dashboard / landing (lab/dashboard/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHECKOUT_URL=https://<store>.lemonsqueezy.com/checkout/buy/<variant-uuid>
NEXT_PUBLIC_PREORDER_PRICE=299 ر.س
